#include <bits/stdc++.h>
using namespace std;

int main() {
    int a[4], total = 0;
    for (int i = 0; i < 4; i++) {
        cin >> a[i];
        total += a[i];
    }

    int ans = INT_MAX;
    for (int mask = 0; mask < (1 << 4); mask++) {
        int sum = 0;
        for (int i = 0; i < 4; i++) {
            if ((mask >> i) & 1) sum += a[i];
        }
        ans = min(ans, abs(total - 2 * sum));
    }

    cout << ans << "\n";
    return 0;
}